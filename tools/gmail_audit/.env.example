# Copy to repository root as `.env` (preferred) OR to `tools/gmail_audit/.env`.
# load_settings() loads the first existing file (see docs/dev/ENV_LOADING.md):
#   GMAIL_AGENT_ENV_FILE -> tools/gmail_audit/.env -> <repo-root>/.env
# .env.vps is for Docker Compose on VPS only (not loaded by load_settings by default).
#
# =============================================================================
# CANONICAL PRODUCTION PROFILE (single operator path for this repo slice)
# =============================================================================
# Set exactly this when running the documented production-shaped stack:
#   docs/runbooks/CANONICAL_PRODUCTION_RUNTIME_AND_OPERATIONS.md
#
# Fail-closed: with this profile, incomplete env raises ConfigError at startup
# (no silent "half enabled" modes).
GMAIL_AGENT_RUNTIME_PROFILE=canonical_production

# --- LLM (default Groq) ---
# DeepSeek is priority #1 in every structured-stage and agent-planner LLM chain when
# DEEPSEEK_API_KEY is set (DEEPSEEK-MIGRATION-1) — tried before Anthropic/the router chain
# below and before the agent planner's Cerebras-first chain. Unset key = unchanged prior
# behavior. Permanent DeepSeek adapter/config errors fail fast instead of being silently masked.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=cerebras,nvidia,openrouter
# Default ON when GROQ + CEREBRAS keys are set: each structured stage alternates groq/cerebras per call (~50% Groq TPM).
# Requires LLM_BACKEND=groq plus GROQ_API_KEY, CEREBRAS_API_KEY, CEREBRAS_BASE_URL. Does not apply to Gmail connector `request_audit`.
# LLM_STRUCTURED_PROVIDER_ALTERNATION=0
GROQ_API_KEY=
# Optional multi-key pool (comma/semicolon/newline). Each key is a separate router attempt on 429/throttle.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
CEREBRAS_API_KEY=
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# NVIDIA NIM (https://integrate.api.nvidia.com/v1 — tool-calling via meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OpenRouter (structured fallback + agent planner; multi-key via OPENROUTER_API_KEYS)
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Provider fallback is bounded to structured LLM stages only. Gmail connector/request_audit
# still requires the Groq path when using --gmail-source groq_connector.
# Central structured LLM (ContextAssembler + Anthropic). When set, structured stages prefer Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# TOPINSTAL_COMPANY_CONTEXT_PATH=/etc/topinstal/company_context.md

# Alternative: LLM_BACKEND=openai_chat + OPENAI_COMPAT_* (Ollama, Cerebras OpenAI-compatible API, …).
# Cerebras quick path (proof): LLM_BACKEND=cerebras + cerebras_api_key + cerebras_model=gpt-oss-120b
# (see https://inference-docs.cerebras.ai/introduction — base URL defaults to https://api.cerebras.ai/v1).

# --- Gmail + Drive (shared refresh token — canonical) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# MUST include gmail.readonly AND drive.readonly for canonical production:
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/calendar.readonly
# Optional debug-only manual token (refresh flow wins when complete):
# GOOGLE_ACCESS_TOKEN=

# --- HTTP ---
HTTP_TIMEOUT=60
HTTP_MAX_RETRIES=4
HTTP_RETRY_BASE_DELAY=2.0

# --- Daszek (Node A REST; operator desk ingest uses technical v2 transport) ---
# Production UI: https://www.topinstal.com.pl/daszek — use origin only (no /daszek suffix).
DASZEK_BASE_URL=https://www.topinstal.com.pl
DASZEK_LOGIN=
DASZEK_PASSWORD=
# Playwright smoke/proof (playwright_daszek_ui_smoke.py, playwright_daszek_pro_proof.py) reuse DASZEK_LOGIN/PASSWORD above.
# Optional aliases: PLAYWRIGHT_DASZEK_USER= / PLAYWRIGHT_DASZEK_PASS=
# Enable POST /wp-json/daszek/v2/ingest and optional readback (set 0 for local dry analysis only).
DASZEK_V2_PUSH=1
DASZEK_V2_READBACK_ENABLED=1
# When 1: allow operator projection ingest even if PolicyEngine returns REJECTED (ingest is not autonomous execution).
DASZEK_V2_DESK_RELAX_REJECTED=1
# When 1: also ingest mail classified as ignore (noisy; use sparingly for inbox visibility debugging).
DASZEK_V2_DESK_INCLUDE_IGNORE=0
# Token for Daszek v2 REST bridge queue drain. Configure the same value on WordPress as DASZEK_BRIDGE_TOKEN.
DASZEK_BRIDGE_TOKEN=
# Optional dedicated token for Node B → WP POST of operational feed / ingress-quality (WordPress: DASZEK_NODE_B_SERVICE_TOKEN).
DASZEK_NODE_B_SERVICE_TOKEN=

# --- Attachment extraction + OCR (canonical ON) ---
ATTACHMENT_EXTRACTION_ENABLED=1
ATTACHMENT_EXTRACTION_MAX_BYTES=8000000

# --- P0 Correlation Registry (Node B — staging/production) ---
# Shared secret: MUST match topinstal-cieplo-orchestrator NODE_B_REGISTRY_TOKEN and RAG GMAIL_AGENT_NODE_B_TOKEN.
# NODE_B_REGISTRY_TOKEN=
# FastAPI registry read/write (orchestrator POST, Daszek/RAG GET). Staging example:
# NODE_B_REGISTRY_BASE_URL=http://127.0.0.1:8765
# Orchestrator workflow context-pack for EngagementSnapshot (async parallel fetch, 2s timeout):
# CIEPLO_WORKFLOW_CONTEXT_BASE_URL=http://127.0.0.1:8000
# CIEPLO_WORKFLOW_CONTEXT_TOKEN=   # optional; defaults to NODE_B_REGISTRY_TOKEN

# --- Mailbox memory Postgres (canonical: live stage) ---
# Align with root `.env.mailbox-memory` / Docker helper; URL-encode password specials.
# Host vs Docker hostname (see docs/ops/MAILBOX_MEMORY_VPS_DEPLOYMENT.md):
#   - Python on the machine shell (Windows/Mac/Linux host): use 127.0.0.1 and MAILBOX_MEMORY_PG_PORT (default 54329), e.g.
#     postgresql://mailbox_memory:PASSWORD@127.0.0.1:54329/mailbox_memory
#   - Python inside docker-compose.vps.yml service gmail-agent-worker only: use service name mailbox-memory-db:5432.
MAILBOX_MEMORY_DATABASE_URL=
# MAILBOX_MEMORY_BLOB_ROOT=   # optional override
MAILBOX_MEMORY_STAGE_MODE=live
MAILBOX_MEMORY_STAGE_ALLOWLIST=

# --- Embeddings + pgvector (canonical ON) ---
# When LLM chat uses Cerebras/Groq OpenAI-compat, embeddings still need a provider that implements
# POST /v1/embeddings (typically local Ollama). Inside docker-compose.vps.yml use the service hostname.
MAILBOX_MEMORY_VECTOR_ENABLED=1
OPENAI_COMPAT_EMBEDDING_BASE_URL=http://ollama:11434/v1
OPENAI_COMPAT_EMBEDDING_API_KEY=
OPENAI_COMPAT_EMBEDDING_MODEL=
OPENAI_COMPAT_EMBEDDING_DIMENSIONS=

# --- Document parse stack (structure-first; canonical ON) ---
DOCLING_ENABLED=1
DOCLING_MAX_PAGES=40
DOCLING_TIMEOUT_SEC=45
# Parser chain: first structured win stops chain (docling → unstructured → legacy stdlib).
ATTACHMENT_PARSER_CHAIN=docling,unstructured,legacy
# Optional Unstructured.io partition backend (heavy deps). Enable only when installed locally.
UNSTRUCTURED_ENABLED=0
# When 1: PDF/DOC attachments skip regex PHONE/CITY facts; use labeled fields from parsers only.
DOCUMENT_STRUCTURED_FACTS=1
# Promote high-confidence document fields into mailbox facts (bounded + provenance). Set 0 to disable.
DOCUMENT_INTELLIGENCE_PROMOTE_FACTS=1

# --- Google Drive ingress (canonical ON) ---
GOOGLE_DRIVE_ENABLED=1
GOOGLE_DRIVE_INGEST_ENABLED=1
GOOGLE_DRIVE_GRAPH_ENABLED=0
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_BATCH_PAGE_SIZE=100
GOOGLE_DRIVE_MAX_DOWNLOAD_BYTES=10000000
# Legacy service-account escape hatch — not part of canonical path:
# GOOGLE_DRIVE_CREDENTIALS_PATH=

# --- Google Calendar V1 (env-gated; refresh OAuth token after changing scopes) ---
GOOGLE_CALENDAR_ENABLED=0
GOOGLE_CALENDAR_ID=primary

# --- Neo4j bounded pilot (canonical ON — projection only, not source of truth) ---
NEO4J_PILOT_ENABLED=1
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Telemetry: local mirror required for canonical; OTLP export optional ---
GMAIL_AGENT_OTEL_ENABLED=0
GMAIL_AGENT_OTEL_LOCAL_MIRROR_ENABLED=1
OTEL_SERVICE_NAME=gmail-agent
# Optional live export (requires reachable collector — not required by canonical contract):
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# --- CEL / signal-active spine (docs/runbooks/SIGNAL_ACTIVE_ONLY.md) ---
# Audit: python tools/gmail_audit/scripts/cel_env_audit.py
SIGNAL_RUNTIME_MODE=active
SIGNAL_WORKER_ENABLED=1
GMAIL_INGRESS_OWNER=signal_worker
GMAIL_CHANGE_DETECTION_ENABLED=1
EVENT_SPINE_PROCESSOR_ENABLED=0
# Epik 2: signal spine before intake LLM (0 = default; 1 = Gate B / legacy order)
INTAKE_LLM_BEFORE_SIGNAL=0
# Lists = operational feed V3; disable per-mail v2 push in worker automate:
DASZEK_V2_PUSH=0
# Epik 3: after reconcile, POST full operational feed (default on when DASZEK_V2_PUSH=0):
# DASZEK_OPERATIONAL_FEED_AUTO_PUSH=1
# DASZEK_OPERATIONAL_FEED_PUSH_MIN_INTERVAL_SEC=60
# Feed source: legacy | engagement_snapshot_v2 (agent SoT; auto when AGENT_RUNTIME_MODE=prep|primary)
# DASZEK_FEED_SOURCE=engagement_snapshot_v2
# Explicit legacy while agent off: DASZEK_FEED_SOURCE=legacy

# --- P1 unified event spine processor (OFF when using signal-worker as sole Gmail ingress) ---
# EVENT_SPINE_PROCESSOR_ENABLED=1
# EVENT_SPINE_PROCESSOR_MODE=shadow
# EVENT_SPINE_PROCESSOR_POLL_INTERVAL_SEC=15
# EVENT_SPINE_PROCESSOR_BATCH_SIZE=25

# --- Fala B3: message HVAC facts (intake LLM vs legacy regex in mailbox_memory) ---
# regex = legacy extract_facts_from_text on message body (default, rollback)
# llm   = use hvac_signals from intake signal_extractor; optional regex fallback if empty
# SIGNAL_EXTRACTION_MODE=llm   # default (B3.3); use regex for rollback only

# --- Fala C2: Skrzat operator copilot (FastAPI POST /cases/{id}/skrzat/ask) ---
# deterministic = legacy tray-based answer (default, Daszek-safe rollback)
# llm           = central_llm_stage skrzat_copilot + context_audit.assembled_context
# SKRZAT_ANSWER_MODE=deterministic

# --- Rich case guidance (optional product feature — default OFF) ---
CASE_GUIDANCE_ENABLED=false
CASE_GUIDANCE_MODEL=
CASE_GUIDANCE_REMOTE_STATE=false

# --- Agent runtime (Stateful Digital Twin — PR-C+) ---
# prep = local Gate B (agent only); primary = VPS production; legacy = rollback (no agent)
# DQ-17: AGENT_RUNTIME_MODE is the ONLY canonical setting for the agent branch.
# AGENT_RUNTIME_ENABLED is deprecated. It is read only when AGENT_RUNTIME_MODE is
# unset, and if both are set and contradict each other the agent stays off and
# startup fails with an explicit configuration error. Do not set it alongside MODE.
AGENT_RUNTIME_MODE=prep
# AGENT_RUNTIME_ENABLED=0   # deprecated legacy fallback — omit when MODE is set
# Planner chain (code order): DeepSeek (priority #1, uses DEEPSEEK_API_KEY/DEEPSEEK_MODEL/
# DEEPSEEK_BASE_URL/DEEPSEEK_THINKING_ENABLED/DEEPSEEK_REASONING_EFFORT above; unset = skipped,
# chain below is unchanged) → Cerebras → NVIDIA → Groq → OpenRouter → optional native OpenAI/Cursor.
# tool_choice=auto (Groq-compatible); case_id guard in planner prompt for follow-ups.
AGENT_CEREBRAS_API_KEY=
AGENT_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
AGENT_CEREBRAS_MODEL=gpt-oss-120b
AGENT_NVIDIA_API_KEY=
AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_NVIDIA_MODEL=gpt-oss-120b
AGENT_GROQ_API_KEY=
AGENT_GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_GROQ_MODEL=openai/gpt-oss-120b
# F3: agent reconcile → kanoniczny LLM projection composer (compose_projection_from_trays)
AGENT_PROJECTION_CANONICAL=1
# VPS / canonical_production (PR-F): AGENT_RUNTIME_MODE=primary
AGENT_MODEL=gpt-4o-mini
# AGENT_MODEL_FALLBACK=deepseek/deepseek-chat:free
AGENT_MAX_ROUNDS=12
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter (dev): set key from https://openrouter.ai/keys then:
# AGENT_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL_FALLBACK=deepseek/deepseek-chat:free
# AGENT_CONSTITUTION_PATH=gmail-agent/docs/core/AGENT_CONSTITUTION.md
# AGENT_CONSTITUTION_RAG_ENABLED=0
KALK_TOP_BASE_URL=https://topinstal.com.pl
KALK_TOP_AGENT_KEY=
KALK_TOP_TIMEOUT_SEC=4
KALK_TOP_MAX_RETRIES=3
# MCP stdio server (PR-G): trigger without agent flag — dev only
# AGENT_MCP_ALLOW_DEBUG=0

# =============================================================================
# DEV / SLICE MODE (not canonical production)
# =============================================================================
# To run partial CI-style checks without the full stack, unset or remove
# GMAIL_AGENT_RUNTIME_PROFILE (or set to empty). Then many flags default OFF
# unless you set them explicitly — see tools/gmail_audit/README.md for details.

# =============================================================================
# LEGACY / COMPAT (discouraged for new setups)
# =============================================================================
# DATABASE_URL=   # legacy alias for MAILBOX_MEMORY_DATABASE_URL (emits warning)
# .env.local is NEVER loaded — merge into .env and delete .env.local
