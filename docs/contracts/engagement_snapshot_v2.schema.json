    },
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionItem"
      },
      "title": "Actions",
      "type": "array"
    },
    "user_instruction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
