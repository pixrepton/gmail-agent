            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "postal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postal Code"
        }
      },
      "title": "HvacLocation",
      "type": "object"
    },
    "HvacProfile": {
      "additionalProperties": false,
      "properties": {
        "heated_area_m2": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heated Area M2"
        },
        "location": {
          "$ref": "#/$defs/HvacLocation"
        },
        "building_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
