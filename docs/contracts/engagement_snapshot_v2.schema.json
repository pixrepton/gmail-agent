          "type": "string"
        },
        "severity": {
          "default": "medium",
          "title": "Severity",
          "type": "string"
        },
        "summary_pl": {
          "default": "",
          "title": "Summary Pl",
          "type": "string"
        }
      },
      "title": "UnderstandingRiskItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "engagement_id": {
      "title": "Engagement Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "signal_id": {
      "default": "",
      "title": "Signal Id",
      "type": "string"
    },
    "trace_id": {
