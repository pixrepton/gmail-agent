{
  "$defs": {
    "ActionItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "payload_pl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Pl"
        },
        "disabled_reason_pl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Reason Pl"
        }
      },
      "required": [
        "id",
        "enabled"
      ],
      "title": "ActionItem",
      "type": "object"
    },
    "AgentMemory": {
      "additionalProperties": false,
      "properties": {
        "reasoning_trace": {
          "items": {
            "$ref": "#/$defs/ReasoningTraceItem"
          },
          "title": "Reasoning Trace",
          "type": "array"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCallItem"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "constitution_sections_used": {
          "items": {
            "type": "string"
          },
          "title": "Constitution Sections Used",
          "type": "array"
        },
        "materialize_proposals": {
          "items": {
            "$ref": "#/$defs/MaterializeProposalItem"
          },
          "title": "Materialize Proposals",
          "type": "array"
        }
      },
      "title": "AgentMemory",
      "type": "object"
    },
    "CaseUnderstandingProjection": {
      "additionalProperties": false,
      "description": "Compact, projection-safe read of case_intelligence_result/understanding_output\nfor the CURRENT turn's signal only (A1). Written atomically with the rest of\nthe snapshot in the same CAS save, so its presence is by construction fresh\nand correlated: graph._ground_current_signal sets it only when a correlated\nUnderstanding was computed for this exact turn's signal, and clears it\n(never leaves it) when that turn had none — see agent_runtime/graph.py.",
      "properties": {
        "source_signal_id": {
          "default": "",
          "title": "Source Signal Id",
          "type": "string"
        },
        "generated_at": {
          "default": "",
          "title": "Generated At",
          "type": "string"
        },
        "essence_pl": {
          "default": "",
          "title": "Essence Pl",
          "type": "string"
        },
        "what_changed_pl": {
          "default": "",
          "title": "What Changed Pl",
          "type": "string"
        },
        "why_pl": {
          "default": "",
          "title": "Why Pl",
          "type": "string"
        },
        "missing_critical_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Critical Fields",
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/UnderstandingRiskItem"
          },
          "title": "Risks",
          "type": "array"
        },
        "recommended_next_step_pl": {
          "default": "",
          "title": "Recommended Next Step Pl",
          "type": "string"
        }
      },
      "title": "CaseUnderstandingProjection",
      "type": "object"
    },
    "GapItem": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "ask_pl": {
          "title": "Ask Pl",
          "type": "string"
        }
      },
      "required": [
        "field",
        "severity",
        "ask_pl"
      ],
      "title": "GapItem",
      "type": "object"
    },
    "HitlGate": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "required"
      ],
      "title": "HitlGate",
      "type": "object"
    },
    "HvacLocation": {
      "additionalProperties": false,
