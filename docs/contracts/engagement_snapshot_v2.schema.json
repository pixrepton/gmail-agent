    "case_kind": {
      "default": "niezaklasyfikowane",
      "enum": [
        "wycena_oferta",
        "awaria_naprawa",
        "przeglad_konserwacja",
        "faktura_sprzedaz",
        "zapytanie_klienta",
        "ksiegowosc",
        "faktura_zakup",
        "zakupy_materialow",
        "szkolenie",
        "inne",
        "niezaklasyfikowane"
