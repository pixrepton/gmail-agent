        },
        "heat_pump_series_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heat Pump Series Hint"
        },
        "thermal_demand_kw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermal Demand Kw"
        },
        "cp2025_eligible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cp2025 Eligible"
        }
      },
      "title": "HvacProfile",
      "type": "object"
    },
    "MaterializeProposalItem": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "proposal_type": {
          "enum": [
            "link_existing",
            "create_case",
            "create_artifact",
            "defer_operator",
            "composite_plan"
          ],
          "title": "Proposal Type",
          "type": "string"
        },
        "payload_json": {
          "additionalProperties": true,
          "title": "Payload Json",
          "type": "object"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "proposal_type"
      ],
      "title": "MaterializeProposalItem",
      "type": "object"
    },
    "OperationalStatus": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "raw_inquiry",
            "enriching",
            "ready_for_quote",
            "pending_operator",
            "node_a_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "steps_remaining": {
          "minimum": 0,
          "title": "Steps Remaining",
          "type": "integer"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "steps_remaining"
      ],
      "title": "OperationalStatus",
      "type": "object"
    },
    "ReasoningTraceItem": {
      "additionalProperties": false,
      "properties": {
