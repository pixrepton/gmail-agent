    "CaseUnderstandingProjection": {
      "additionalProperties": false,
      "description": "Compact, projection-safe read of case_intelligence_result/understanding_output\nfor the CURRENT turn's signal only (A1). Written atomically with the rest of\nthe snapshot in the same CAS save, so its presence is by construction fresh\nand correlated: graph._ground_current_signal sets it only when a correlated\nUnderstanding was computed for this exact turn's signal, and clears it\n(never leaves it) when that turn had none — see agent_runtime/graph.py.",
      "properties": {
        "source_signal_id": {
          "default": "",
          "title": "Source Signal Id",
          "type": "string"
        },
        "generated_at": {
          "default": "",
          "title": "Generated At",
          "type": "string"
        },
        "essence_pl": {
          "default": "",
          "title": "Essence Pl",
          "type": "string"
        },
        "what_changed_pl": {
          "default": "",
          "title": "What Changed Pl",
          "type": "string"
        },
        "why_pl": {
          "default": "",
          "title": "Why Pl",
          "type": "string"
        },
        "missing_critical_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Critical Fields",
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/UnderstandingRiskItem"
          },
          "title": "Risks",
          "type": "array"
        },
        "recommended_next_step_pl": {
          "default": "",
          "title": "Recommended Next Step Pl",
          "type": "string"
        }
      },
      "title": "CaseUnderstandingProjection",
      "type": "object"
    },
    "CaseUnderstandingProvenance": {
      "additionalProperties": false,
      "description": "SLICE-3A: `CaseUnderstandingProvenanceV1` — how the sibling `case_understanding` was produced.\n\nDeliberately a SEPARATE, small envelope rather than fields inside\n`CaseUnderstandingProjection`: the projection is Brain 1's semantic content, this is metadata\nabout the run that produced it. Keeping them apart means a reader can trust the content\nwithout having to strip bookkeeping out of it, and there is still exactly one semantic\nrepresentation of the case — no third model.\n\nEvery field is optional with an honest empty default. An empty string means \"not known\",\nnever a fabricated status: a snapshot written before this slice simply has\n`case_understanding_provenance = None` and gets no invented provenance.\n\n`corrected` is NOT `degraded`. A normalisation may be a harmless synonym rewrite or a real\ndictionary collision, and nothing in the current code distinguishes them. Until a severity\ncontract exists, this records WHAT happened and refuses to editorialise about how bad it was.",
      "properties": {
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "availability": {
          "default": "",
          "enum": [
            "available",
            "unavailable",
            "not_required",
            ""
          ],
          "title": "Availability",
          "type": "string"
        },
        "source_mode": {
          "default": "",
          "enum": [
            "model_result",
            "normalized_model_result",
            "fallback",
            "skipped_for_lane",
            ""
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "validation_state": {
          "default": "",
          "enum": [
            "clean",
            "corrected",
            ""
          ],
          "title": "Validation State",
          "type": "string"
        },
        "source_signal_id": {
          "default": "",
          "title": "Source Signal Id",
          "type": "string"
        },
        "observed_at": {
          "default": "",
          "title": "Observed At",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "normalization_count": {
          "default": 0,
          "minimum": 0,
          "title": "Normalization Count",
          "type": "integer"
        },
        "validation_error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Validation Error Count",
          "type": "integer"
        }
      },
      "title": "CaseUnderstandingProvenance",
      "type": "object"
    },
    "FeedVisibility": {
      "additionalProperties": false,
      "description": "SLICE-2B: routing/projection metadata deciding operator MAIN-feed membership.\n\nThis is NOT a new semantic truth about the case — it records how the signal was routed and\nwhy, so `snapshot exists` stops implying `belongs in the operator feed`. Optional and\nadditive: snapshots written before this slice validate unchanged and are treated as\n`main_feed` by an explicit legacy fallback.",
      "properties": {
        "mode": {
          "default": "main_feed",
          "enum": [
            "hidden",
            "case_timeline_only",
            "main_feed",
            "attention_required"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source_lane": {
          "default": "",
          "title": "Source Lane",
          "type": "string"
        },
        "source_triage_class": {
          "default": "",
          "title": "Source Triage Class",
          "type": "string"
        },
        "operator_override": {
          "default": false,
          "title": "Operator Override",
          "type": "boolean"
        },
        "execution_attention": {
          "default": false,
          "title": "Execution Attention",
          "type": "boolean"
        },
        "execution_attention_reason": {
          "default": "",
          "title": "Execution Attention Reason",
          "type": "string"
        }
      },
      "title": "FeedVisibility",
      "type": "object"
    },
