# Copy to .env.daszek-local (same directory; gitignored). Loaded by docker-compose.daszek-local.yml.
#
# Mirror secrets from gmail-agent/tools/gmail_audit/.env when testing Skrzat proxy or Node B → WP bridge push:
#   NODE_B_REGISTRY_TOKEN       →  DASZEK_NODE_B_API_TOKEN
#   DASZEK_BRIDGE_TOKEN         →  DASZEK_BRIDGE_TOKEN
#   DASZEK_NODE_B_SERVICE_TOKEN →  DASZEK_NODE_B_SERVICE_TOKEN  (feed/ingress POST; may equal bridge locally)
#
# Node B URL is fixed in compose WORDPRESS_CONFIG_EXTRA:
#   DASZEK_NODE_B_API_BASE=http://host.docker.internal:8766
#
# For Node B auto-push to local WP, set in gmail-agent/tools/gmail_audit/.env (worker mount):
#   DASZEK_BASE_URL=http://host.docker.internal:8090
#   DASZEK_LOGIN=konrad
#   DASZEK_PASSWORD=konrad123
#   DASZEK_BRIDGE_TOKEN=<same as NODE_B_REGISTRY_TOKEN>
#   DASZEK_NODE_B_SERVICE_TOKEN=<same or dedicated>
#   DASZEK_OPERATIONAL_FEED_AUTO_PUSH=1
#   DASZEK_OPERATIONAL_FEED_PUSH_MIN_INTERVAL_SEC=15
#   DASZEK_V2_PUSH=0
#   DASZEK_FEED_SOURCE=engagement_snapshot_v2

DASZEK_NODE_B_API_TOKEN=
DASZEK_BRIDGE_TOKEN=
DASZEK_NODE_B_SERVICE_TOKEN=
