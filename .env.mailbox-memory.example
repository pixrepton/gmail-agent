# Copy to `.env.mailbox-memory` (gitignored) and tune for your machine / VPS.
# Docker Compose reads this when you use:
#   docker compose --env-file .env.mailbox-memory -f docker-compose.mailbox-memory.yml up -d
#
# Python runtime (`tools/gmail_audit/.env`) must use the SAME user, password, db name, host, port
# in MAILBOX_MEMORY_DATABASE_URL.

# --- Postgres inside the container (official image variables) ---
MAILBOX_MEMORY_POSTGRES_DB=mailbox_memory
MAILBOX_MEMORY_POSTGRES_USER=mailbox_memory
# Required. Replace this placeholder before first docker compose up.
MAILBOX_MEMORY_POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Host port mapping: host:container is ${MAILBOX_MEMORY_PG_PORT}:5432 ---
MAILBOX_MEMORY_PG_PORT=54329

# --- Docker ---
MAILBOX_MEMORY_CONTAINER_NAME=gmail-agent-mailbox-memory
