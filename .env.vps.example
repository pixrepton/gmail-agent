# Copy to `.env.vps` on the VPS (same directory as `docker-compose.vps.yml`).
#   cp .env.vps.example .env.vps
# Edit secrets; never commit `.env.vps`.
#
# Scope: variables used by Docker Compose for `docker-compose.vps.yml` substitution
# (ports, image build args, DB/Neo4j passwords, worker command).
# Application secrets (Gmail, Groq/Cerebras/NVIDIA LLM, agent planner, Daszek, MAILBOX_MEMORY_DATABASE_URL, etc.) live in
# `tools/gmail_audit/.env` or `.env.local-vps` (mounted as /etc/topinstal/gmail-agent.env) — see those `.example` files.
#
# Compose loads every KEY=value from this file for ${VAR} substitution in `docker-compose.vps.yml`.
# Extra keys (e.g. `VPS=...`) that are not referenced in the compose file have **no effect** on
# Postgres/Neo4j/worker unless you add matching `environment:` entries yourself. Prefer the
# explicit variables above for service passwords.
#
# Docker Compose `$` escaping: if a value in THIS file contains a literal dollar sign, double it:
#   DASZEK_PASSWORD=$$MVV7t9cqcJVxvsqbPP[kMtt
# Compose passes a single `$` through to the container. On VPS run:
#   bash deploy/vps-compose-escape-env-vps.sh
# Production Daszek login/password live in `/etc/topinstal/gmail-agent.env` (single-quoted there).

COMPOSE_PROJECT_NAME=gmail-agent-vps

# --- Postgres + pgvector (mailbox memory) ---
MAILBOX_MEMORY_POSTGRES_DB=mailbox_memory
MAILBOX_MEMORY_POSTGRES_USER=mailbox_memory
# Required by compose (no default): set a strong password in `.env.vps`.
MAILBOX_MEMORY_POSTGRES_PASSWORD=CHANGE_ME_VPS_STRONG_PASSWORD
MAILBOX_MEMORY_PG_PORT=54129
MAILBOX_MEMORY_CONTAINER_NAME=gmail-agent-mailbox-memory

# --- Neo4j (bounded pilot; not mailbox source of truth) ---
# Required by compose (no default): min 12 chars for Neo4j 5 image policy.
NEO4J_PASSWORD=CHANGE_ME_VPS_STRONG_PASSWORD
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Host port for gmail-agent-nodeb-api (default 8765; use 8766 when Cursor occupies 8765)
GMAIL_AGENT_NODEB_PORT=8766

# --- Worker image build ---
# 1 = install Docling in the image (heavier build).
GMAIL_AGENT_INSTALL_DOCLING=0

# --- Ollama (embeddings for pgvector path) ---
OLLAMA_HTTP_PORT=11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- gmail-agent-worker default command (override per deployment) ---
# P0 shadow rollout (deploy/p0-vps-rollout.sh sets this on VPS):
GMAIL_AGENT_WORKER_COMMAND=python tools/gmail_audit/gmail_intake.py signal-worker --loop --verbose
#
# App flags (SIGNAL_RUNTIME_MODE=active, SIGNAL_WORKER_ENABLED=1, GMAIL_INGRESS_OWNER=signal_worker, …)
# live in tools/gmail_audit/.env mounted as /etc/topinstal/gmail-agent.env — NOT in .env.vps.
# Do NOT use deploy/p0-vps-rollout.sh shadow flags (historical). Audit: scripts/cel_env_audit.py
