# Local developer machine env that is mounted into containers as:
#   /etc/topinstal/gmail-agent.env
#
# Copy:
#   copy .env.local-vps.example .env.local-vps
#
# IMPORTANT:
# - Do not commit `.env.local-vps` (keep it gitignored if not already).
# - This file is the "application env" for the local-vps compose stack.
#
# Minimal local recipe:
# - Run Postgres/Neo4j/Ollama via docker compose (see docker-compose.local-vps.yml)
# - Set MAILBOX_MEMORY_DATABASE_URL to point at the dockerized Postgres (service hostname from inside docker)
# - Set OPENAI_COMPAT_EMBEDDING_BASE_URL to Ollama service (inside docker network)

# Use `default` locally — `canonical_production` requires NEO4J_PILOT_ENABLED=1 among other VPS flags.
GMAIL_AGENT_RUNTIME_PROFILE=default
CASE_OS_RUNTIME_PROFILE=full

# --- Mailbox memory DB (inside docker network for worker/api containers) ---
MAILBOX_MEMORY_DATABASE_URL=postgresql://mailbox_memory:CHANGE_ME_VPS_STRONG_PASSWORD@mailbox-memory-db:5432/mailbox_memory
MAILBOX_MEMORY_VECTOR_ENABLED=1

# --- Embeddings provider (inside docker network) ---
OPENAI_COMPAT_EMBEDDING_BASE_URL=http://ollama:11434/v1
OPENAI_COMPAT_EMBEDDING_API_KEY=
OPENAI_COMPAT_EMBEDDING_MODEL=nomic-embed-text

# --- Neo4j GraphRAG pilot (inside docker network) ---
# Enable after NEO4J_PASSWORD matches .env.vps (first container init is sticky).
# Postgres remains SoT; Neo4j is bounded case-context projection for retrieval.
NEO4J_PILOT_ENABLED=1
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_VPS_STRONG_PASSWORD
NEO4J_DATABASE=neo4j

# --- Structured LLM (ContextAssembler stages feeding Neo4j-enriched packs) ---
# Chain: gpt-4o-mini (OpenAI) → Groq → Cerebras (bounded fallback on transient errors).
LLM_BACKEND=openai_chat
LLM_PRIMARY_PROVIDER=openai_chat
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
LLM_FALLBACK_PROVIDERS=groq,cerebras
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# NVIDIA NIM hosted API (build.nvidia.com free endpoints; OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=gpt-oss-120b

# --- Agent planner LLM chain (tool selection; OpenAI-compatible endpoints) ---
# Order (code): Cerebras → NVIDIA → Groq → OpenRouter → optional native OpenAI/Cursor.
# tool_choice=auto (Groq does not support required); case_id guard in planner prompt.
AGENT_CEREBRAS_API_KEY=
AGENT_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
AGENT_CEREBRAS_MODEL=gpt-oss-120b
AGENT_GROQ_API_KEY=
AGENT_GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_GROQ_MODEL=openai/gpt-oss-120b
AGENT_MODEL=gpt-4o-mini
AGENT_MODEL_FALLBACK=openrouter/free
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional tail fallbacks (after hosted chain above):
# AGENT_OPENAI_NATIVE_API_KEY=
# AGENT_OPENAI_NATIVE_BASE_URL=https://api.openai.com/v1
# AGENT_CURSOR_API_KEY=
# AGENT_CURSOR_BASE_URL=https://api.cursor.com/v1
AGENT_NVIDIA_API_KEY=
AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_NVIDIA_MODEL=gpt-oss-120b

# --- Correlation registry / Node B token (optional, leave empty locally) ---
# NODE_B_REGISTRY_TOKEN=
NODE_B_REGISTRY_BASE_URL=http://127.0.0.1:8766

# --- CEL / signal-active (sync with tools/gmail_audit/.env — docker DB host) ---
SIGNAL_RUNTIME_MODE=active
SIGNAL_WORKER_ENABLED=1
GMAIL_INGRESS_OWNER=signal_worker
GMAIL_CHANGE_DETECTION_ENABLED=1
EVENT_SPINE_PROCESSOR_ENABLED=1
EVENT_SPINE_PROCESSOR_MODE=shadow
UNIFIED_SIGNAL_RUNTIME_ENABLED=1
INTAKE_LLM_BEFORE_SIGNAL=0
DASZEK_V2_PUSH=0
DASZEK_V2_READBACK_ENABLED=0

# --- Daszek bridge (local sandbox :8090 — Node B on host :8766) ---
DASZEK_BASE_URL=http://host.docker.internal:8090
DASZEK_LOGIN=konrad
DASZEK_PASSWORD=konrad123
DASZEK_BRIDGE_TOKEN=
DASZEK_NODE_B_SERVICE_TOKEN=
DASZEK_OPERATIONAL_FEED_AUTO_PUSH=1
DASZEK_OPERATIONAL_FEED_PUSH_MIN_INTERVAL_SEC=15
DASZEK_FEED_SOURCE=engagement_snapshot_v2
DASZEK_V2_READBACK_ENABLED=0

# --- Max local capabilities (default profile) ---
MAILBOX_MEMORY_STAGE_MODE=live
DOCLING_ENABLED=1
ATTACHMENT_EXTRACTION_ENABLED=1
GOOGLE_DRIVE_ENABLED=1
GOOGLE_DRIVE_INGEST_ENABLED=1
GOOGLE_DRIVE_GRAPH_ENABLED=1
GOOGLE_CALENDAR_ENABLED=1
GMAIL_AGENT_OTEL_LOCAL_MIRROR_ENABLED=1
CASE_INTELLIGENCE_VNEXT_ENABLED=1
UNDERSTANDING_OUTPUT_ENABLED=1
DECISION_PIPELINE_ENABLED=1
SERVICE_REQUEST_PLAYBOOK_ENABLED=1
ACTION_PROPOSAL_V2_ENABLED=1
AGENT_RUNTIME_ENABLED=1
AGENT_RUNTIME_MODE=prep
# F3: agent reconcile → kanoniczny LLM projection composer (compose_projection_from_trays)
AGENT_PROJECTION_CANONICAL=1
AGENT_CONSTITUTION_RAG_ENABLED=1
UNIFIED_SIGNAL_RUNTIME_ENABLED=1
#
# Production example:
# DASZEK_BASE_URL=https://www.topinstal.com.pl
