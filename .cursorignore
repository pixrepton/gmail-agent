# Index hygiene only; not project truth governance.
# Keeps local/generated/heavy/private artifacts out of Cursor indexing.
# Does not replace .gitignore.

# VCS / local IDE / agent caches
.git/**
.vscode/**
.cursor/plans/**
!.cursor/plans/README.md
_workspace_archive/**
.agent-tooling-cache/**
.playwright-mcp/**
.serena/**
.claude/**
.gitnexus/**
**/.gitnexus/**
graphify-out/**

# Python cache / test cache
.pytest_cache/**
**/.pytest_cache/**
__pycache__/**
**/__pycache__/**
**/**pycache**/**
*.pyc
*.pyo
.mypy_cache/**
.ruff_cache/**
htmlcov/**
coverage/**
.coverage

# Virtual envs
.venv/**
venv/**
env/**

# Runtime / raw proof artifacts
runs/**
tools/gmail_audit/runs/**
Daszek/uploads/**
*.log

# Static intelligence raw/generated artifacts
repo-intelligence/*.gexf
repo-intelligence/*.graphml
repo-intelligence/*.json
repo-intelligence/*viewer*.html
!repo-intelligence/domain_catalog.json

# Long reference sources; keep summaries visible.
docs/reference/tekst1.md

# Node/frontend build artifacts
node_modules/**
dist/**
build/**
.next/**
.cache/**
.parcel-cache/**
.vite/**

# Vendor / temp files
vendor/**
tmp/**
temp/**
*.tmp
*.bak
*.swp
*.swo

# Archives / exports / bulky packages
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Local databases/state files
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Secrets / credentials
.env
.env.*
!**/.env.example
!**/.env.*.example
id_rsa
id_ed25519
*_rsa
*_ed25519
*.pem
*.key
*.ppk
*token*
*credentials*
credentials.json
token.json

